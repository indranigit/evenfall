# Server only. Do not put credentials in app/, VITE_* variables, or commits.
HOST=127.0.0.1
PORT=8780
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
ENABLE_CLOUD=false
# Personal mode: supply a random token of at least 32 characters securely.
EVENFALL_ACCESS_TOKEN=
# Or Auth0: configure an API audience, RS256 tokens and evenfall:use scope.
AUTH0_ISSUER=
AUTH0_AUDIENCE=
# Optional OpenAI-compatible local Gemma server, e.g. Ollama /v1.
GEMMA_BASE_URL=http://127.0.0.1:11434/v1
GEMMA_MODEL=gemma3:1b
GEMMA_API_KEY=
ELEVENLABS_API_KEY=
SERPAPI_API_KEY=
MONGODB_URI=
SENTRY_DSN=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
# Optional CPU predictor. Download licensed weights separately, then set path.
ENABLE_TABPFN=false
TABPFN_MODEL_PATH=
PYTHON_BIN=python3
